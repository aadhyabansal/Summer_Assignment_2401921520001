public class Codec {

    public String serialize(TreeNode root) {
        if(root==null) return "";
        Queue<TreeNode> q=new LinkedList<>();
        StringBuffer s=new StringBuffer();
        q.offer(root);
        while(!q.isEmpty()){
            TreeNode temp=q.poll();
            if(temp==null){
                s.append("# ");
                continue;
            }
            else s.append(temp.val+" ");
            q.offer(temp.left);
            q.offer(temp.right);
        }
        return s.toString();
    }

    public TreeNode deserialize(String data) {
        if(data.equals("")) return null;
        Queue<TreeNode> q=new LinkedList<>();
        String[] s=data.split(" ");
        TreeNode root=new TreeNode(Integer.parseInt(s[0]));
        q.offer(root);
        for(int j=1; j<s.length; j++){
            TreeNode temp=q.poll();
            if(!s[j].equals("#")){   
                temp.left= new TreeNode(Integer.parseInt(s[j]));
                q.offer(temp.left);
            }
            if(!s[++j].equals("#")){
                temp.right= new TreeNode(Integer.parseInt(s[j]));
                q.offer(temp.right);
            }
        }
        return root;
    }
}

