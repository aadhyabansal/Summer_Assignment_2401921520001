class Solution {
    public int strStr(String haystack, String needle) {
        int n1=haystack.length(), n2=needle.length();
        if(n1<n2) return -1;
        int[] lps=new int[n2];

        int ind=1,len=0;
        while(ind<n2){
            if(needle.charAt(ind)==needle.charAt(len)){
                len++;
                lps[ind]=len;
                ind++;
            }
            else{
                if(len!=0){
                    len=lps[len-1];
                }
                else{
                    lps[ind]=0;
                    ind++;
                }
            }
        }
        int j=0,i=0;
        while(i<n1 && j<n2){
            if(haystack.charAt(i)==needle.charAt(j)){
                i++;
                j++;
                if(j==n2) return i-n2;
            }
            else{
                if(j>0) j=lps[j-1];
                else i++;
            }
        }
        return -1;
    }
}