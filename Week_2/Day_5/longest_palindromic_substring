class Solution {
    public String longestPalindrome(String s) {
        int len=1, ind=0, n=s.length();
        for(int i=0; i<n; i++){
            int l=i, h=i;
            while(l>=0 && h<n && s.charAt(l)==s.charAt(h)){
                if(len<h-l+1){
                    len=h-l+1;
                    ind=l;
                }
                l--;
                h++;
            }         
            l=i; h=i+1;
            while(l>=0 && h<n && s.charAt(l)==s.charAt(h)){
                if(len<h-l+1){
                    len=h-l+1;
                    ind=l;
                }
                l--;
                h++;
            }
        }
        StringBuilder ans=new StringBuilder();
        int i=ind;
        while(i<ind+len){
            ans.append(s.charAt(i));
            i++;
        }
        return ans.toString();
    }
}