class Solution {
    public double findMaxAverage(int[] nums, int k) {
        int n=nums.length, sum=nums[0];
        for(int i=1; i<k; i++){
            sum+=nums[i];
        }
        int maxs=sum;
        for(int i=k; i<n; i++){
            sum-=nums[i-k];
            sum+=nums[i];
            maxs=Math.max(maxs,sum);
        }
        return (double)maxs/k;
    }
}