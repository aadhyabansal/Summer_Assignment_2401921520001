class Solution {
    public int[] sortedSquares(int[] nums) {
        int l=0, n=nums.length, h=n-1, ind=n-1;
        int[] ans=new int[n];
        while(l<=h){
            int sql=nums[l]*nums[l];
            int sqh=nums[h]*nums[h];
            if(sql>sqh){
                ans[ind]=sql;
                l++;
            }
            else{
                ans[ind]=sqh;
                h--;
            }
            ind--;
        }
        return ans;
    }
}