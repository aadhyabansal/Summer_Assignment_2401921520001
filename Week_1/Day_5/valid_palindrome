class Solution {
    public boolean isPalindrome(String s) {
        int h=s.length()-1, l=0;
        while(l<h){
            while(!Character.isLetterOrDigit(s.charAt(l))) l++;
            while(!Character.isLetterOrDigit(s.charAt(h))) h--;
            if(Character.toUpperCase(s.charAt(l))!=Character.toUpperCase(s.charAt(h))) return false;
            System.out.print(l);
            l++;
            h--;
        }
        return true;
    }
}